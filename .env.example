# Copy to .env and uncomment only what you use (NAME= sets an empty value).
# Load it with: set -a; . ./.env; set +a

# Where a local judge's config reads its weights: $RULEFORGE_MODEL_ROOT/<weights directory>
# RULEFORGE_MODEL_ROOT=
# Campaign roots, populations, fetched Hub data and launch records
# RULEFORGE_ARTIFACT_ROOT=
# Paid Batch API judges' state, kept across resumes
# RULEFORGE_BATCH_ROOT=

# SLURM partition, for ruleforge jobs launch without --profile
# RULEFORGE_SLURM_PARTITION=
# SLURM account (optional)
# RULEFORGE_SLURM_ACCOUNT=
# Your SLURM cluster profiles (--slurm NAME, --profile NAME)
# RULEFORGE_CLUSTER_DIR=

# API keys; a judge that bills its calls also needs --yes-spend
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HF_TOKEN=

# Weights & Biases; WANDB_MODE=offline needs no account
# WANDB_API_KEY=
# WANDB_ENTITY=
# WANDB_MODE=

# TIKTOKEN_RS_CACHE_DIR=
# UV_CACHE_DIR=
# HF_HOME=
